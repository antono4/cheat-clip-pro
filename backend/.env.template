# CHEAT CLIP PRO — Environment Template
# ============================================================
# This app can run locally or deployed to a server.
# API keys for Gemini can be provided by users at runtime via the web interface.
#
# Get a free Gemini API key at: https://aistudio.google.com/
# ============================================================

# ── Gemini API (Optional Server Default) ──────────────────────
# If not set here, users must provide it in the web interface.
# Also required for AI video generation (Google Veo), which has no
# Moonshot/Kimi equivalent — Kimi keys can write prompts but cannot
# render video.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Moonshot (Kimi) API (Optional Server Default) ─────────────
# Enables the Kimi K3/K2 model family as an alternative AI engine.
# Users can also supply their own key in the web interface; Cheat Clip Pro
# auto-detects the provider from the key prefix (`AIza...` = Gemini,
# `sk-...` = Moonshot/Kimi).
#
# Get a key at: https://platform.kimi.ai/
# MOONSHOT_API_KEY=your_moonshot_api_key_here
#
# Optional: point Kimi calls at a proxy or an OpenAI-compatible aggregator.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# ── Admin API Key (Destructive System Endpoints) ──────────────
# Protects /api/system/update, /api/system/restart, /api/clear-temp,
# /api/cleanup-expired-temp and /api/auto-cleanup.
#
# Behavior:
#   * If ADMIN_API_KEY (or CHEAT_CLIP_API_KEY) is set, every call to those
#     endpoints must send it via the "X-API-Key: <key>" header.
#   * If it is NOT set, those endpoints are allowed only for local requests
#     on a non-server environment. In server/Docker/cloud mode they return 403,
#     so an unauthenticated remote attacker cannot trigger updates or restarts.
#
# STRONGLY RECOMMENDED when exposing the app on a public host, e.g.:
# ADMIN_API_KEY=change_me_to_a_long_random_string

# ── In-Memory Job Registry (Optional Tuning) ──────────────────
# Download/render job state is kept in memory and pruned by the background
# worker. Entries that are still running never expire; finished entries are
# reclaimed after JOB_TTL_SECONDS or when a registry exceeds JOB_MAX_ENTRIES.
# JOB_TTL_SECONDS=3600
# JOB_MAX_ENTRIES=500

# ── Supadata API Keys (Tier 1 Fallback) ────────────────────────
# Supadata provides cloud-hosted residential IP proxying for YouTube transcripts.
# Multiple keys can be comma-separated or space-separated for automatic round-robin rotation.
# Get free keys (100 credits/mo each) at: https://supadata.ai/
# SUPADATA_API_KEYS=sd_key1,sd_key2,sd_key3

# ── Webshare Rotating Proxy (Tier 2-4 Fallback) ───────────────
# Per https://github.com/jdepoix/youtube-transcript-api#working-around-ip-bans-requestblocked-or-ipblocked-exception
# Webshare rotating proxies prevent YouTube datacenter IP bans (IpBlocked/RequestBlocked).
# Register at: https://www.webshare.io/
# WEBSHARE_USERNAME=your_username
# WEBSHARE_PASSWORD=your_password
# WEBSHARE_LOCATIONS=US,GB,DE
# WEBSHARE_RETRIES=5

# Alternatively, define the full Webshare proxy URL or generic proxy:
# WEBSHARE_PROXY=http://username-rotate:password@p.webshare.io:80
# PROXY_URL=http://username:password@proxy_host:port
#
# Any of the above routes video downloads, metadata and transcripts through the
# proxy. Set one if you run on a datacenter/cloud/VPN host: YouTube answers a
# bare datacenter IP with "HTTP error 403 Forbidden" on every clip download.

# ── Custom SSL Certificate Bundle (Optional) ─────────────────
# Path to custom CA bundle if running behind an SSL-inspecting proxy
# REQUESTS_CA_BUNDLE=/path/to/cacert.pem

# ── Color Emoji Font Path (Optional) ─────────────────────────
# Path to a color emoji font (.ttf / .otf) such as NotoColorEmoji.ttf or seguiemj.ttf
# If not specified, cheat-clip-pro automatically uses backend/fonts/seguiemj.ttf or system fonts.
# EMOJI_FONT_PATH=/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf

